<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- صلاحيات الشبكة -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- صلاحيات الموقع (لازمة لمكتبة geolocator عشان نحدد موقع الزبون -->
    <!-- ونبعته مع الطلبية لتطبيق السائق) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- ✅ الجديد — لازمة لأندرويد 13+ (API 33+) عشان يقدر التطبيق يعرض -->
    <!-- إشعارات Push فوق الشاشة. بدونها الإشعارات بتوصل بصمت بدون ما تظهر. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="customer_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Theme عادي للـ Flutter -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />

            <!-- Launcher principal -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ============================================================ -->
            <!-- ✅ Deep Link: لازم عشان متى الباك إند بيرجعك على            -->
            <!--    customerapp://auth?token=xxx أندرويد يفتح التطبيق تلقائياً  -->
            <!-- ============================================================ -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="customerapp" android:host="auth" />
            </intent-filter>
            <!-- ============================================================ -->

        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ============================================================ -->
        <!-- ✅ الجديد — إعدادات إشعارات Push (نفس أسلوب تطبيق العامل)     -->
        <!-- ============================================================ -->

        <!-- الأيقونة الافتراضية لإشعارات FCM لما يكون التطبيق بالخلفية -->
        <!-- (لازم نضيف ملف ic_notification.png بمجلدات drawable) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- الـ channel الافتراضي لإشعارات الزبون (نفسه اللي بـ -->
        <!-- firebase_messaging_manager.dart) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="warehouse_customer_notifications" />
        <!-- ============================================================ -->

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- لازم عشان يقدر يفتح Chrome -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>